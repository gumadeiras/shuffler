# stagehand configuration. Copy this file to stages.toml (git-ignored) and edit it.
# `uv run stagehand ports` lists the COM ports and Thorlabs serial numbers.

[app]
# Saved positions, relative to this file.
presets = "presets.json"
# Stage labels and card order, set in the window (double-click a stage title).
labels = "labels.json"
# Where Thorlabs Kinesis is installed (64-bit).
kinesis_dir = "C:/Program Files/Thorlabs/Kinesis"
# Connect to every stage when the window opens.
connect_on_start = true
# Ask before a home search and before going to a preset.
confirm_moves = true

# One [[stage]] table per controller.
#
#   name       fixed key for this controller. Presets store positions under it, so
#              do not change it after you save presets. To give the stage an axis
#              name ("X", "Odor Z"), rename it in the window instead: double-click
#              its title. Use ... > Move left / Move right to order the cards.
#   driver     "conex" (Newport CONEX-CC) or "kinesis" (Thorlabs K-Cube)
#   port       conex: the COM port
#   serial     kinesis: the 8-digit serial number (28xxxxxx = KBD101, 27xxxxxx = KDC101)
#   min, max   optional: a safe range inside the controller's travel. Moves outside
#              it are refused. Use this to keep a stage clear of the objective.
#   velocity   optional: set on connect, in units/s. Omit it to keep the device value.
#   jog_steps  optional: the step sizes offered for the - and + buttons
#   decimals   optional: digits shown after the decimal point (default 4)

[[stage]]
name = "CONEX A"
driver = "conex"
port = "COM3"
# min = 0.0
# max = 25.0

[[stage]]
name = "CONEX B"
driver = "conex"
port = "COM4"

[[stage]]
name = "DDS100"
driver = "kinesis"
serial = "28253849"
jog_steps = [0.01, 0.1, 1.0, 10.0]
# velocity = 10.0
